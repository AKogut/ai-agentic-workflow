# One Discord webhook per watched repository (Edit Channel → Integrations → Webhooks).
# Variable name: DISCORD_WEBHOOK_ + the repository name in upper snake case.
# Copy to .env, which is gitignored: anyone holding a URL can post to the channel.
DISCORD_WEBHOOK_AI_FLAKY_TEST_TRIAGE=
DISCORD_WEBHOOK_EPHEMERAL_K8S_TEST_ENVS=
DISCORD_WEBHOOK_FLAKEMETRY=
DISCORD_WEBHOOK_MOBILE_TASK_MANAGER_AUTOMATION=
DISCORD_WEBHOOK_PLAYWRIGHT_ECOMMERCE_FRAMEWORK=
DISCORD_WEBHOOK_RESTFUL_BOOKER_API_TESTING=
