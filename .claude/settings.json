{
  "permissions": {
    "allow": [
      "Bash(./scripts/collect.sh:*)",
      "Bash(./scripts/failed-log.sh:*)",
      "Bash(./scripts/repo.sh:*)",
      "Bash(./scripts/notify.sh:*)",
      "Bash(./scripts/fix-start.sh:*)",
      "Bash(./scripts/app.sh check)",
      "Edit(./.kogut/outbox/**)",
      "Edit(./.kogut/fixes/**)",
      "Bash(jq:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)"
    ],
    "ask": [
      "Bash(./scripts/merge-dependabot.sh:*)",
      "Bash(./scripts/open-fix-pr.sh:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr review:*)",
      "Bash(gh api:*)",
      "Bash(git push:*)",
      "Bash(curl:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(~/.config/kogut/**)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh workflow disable:*)",
      "Bash(gh *pr merge*--admin*)"
    ]
  }
}
