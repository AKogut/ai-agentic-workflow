{
  "permissions": {
    "allow": [
      "Bash(./scripts/collect.sh:*)",
      "Bash(./scripts/failed-log.sh:*)",
      "Bash(./scripts/repo.sh:*)",
      "Bash(./scripts/notify.sh:*)",
      "Edit(./.kogut/outbox/**)",
      "Bash(jq:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(git push:*)",
      "Bash(curl:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh workflow disable:*)"
    ]
