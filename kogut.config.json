{
  "owner": "AKogut",
  "app": {
    "slug": "kogut-agent",
    "id": 5544051,
    "homepage": "https://github.com/AKogut/ai-agentic-workflow"
  },
  "policy": {
    "cooldown_days": 3,
    "cooldown_skip_severity": "high",
    "stale_pr_days": 7,
    "inactivity_warn_days": 45,
    "run_window": 30,
    "followup_limit": 3,
    "pr_run_limit": 2,
    "secret_warn_days": 80,
    "secret_ignore": [],
    "infra_retry_limit": 6,
    "auto_merge": { "enabled": true, "limit_per_repo": 5 },
    "parallel_agents": 3,
    "feature": {
      "repos": ["mobile-task-manager-automation"],
      "max_files": 30,
      "max_lines": 1500,
      "followup_limit": 8
    }
  },
  "repos": [
    { "name": "ai-flaky-test-triage", "path": "~/GitHubPersonal/ai-flaky-test-triage" },
    { "name": "ephemeral-k8s-test-envs", "path": "~/GitHubPersonal/ephemeral-k8s-test-envs" },
    { "name": "flakemetry", "path": "~/GitHubPersonal/flakemetry" },
    { "name": "mobile-task-manager-automation", "path": "~/GitHubPersonal/mobile-task-manager-automation" },
    { "name": "playwright-ecommerce-framework", "path": "~/GitHubPersonal/playwright-ecommerce-framework" },
    { "name": "restful-booker-api-testing", "path": "~/GitHubPersonal/restful-booker-api-testing" }
  ]
}
